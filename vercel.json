{
  "version": 2,
  "builds": [
    {
      "src": "app/fda_dashboard.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.13"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/fda_dashboard.py"
    }
  ],
  "functions": {
    "app/fda_dashboard.py": {
      "memory": 3008,
      "maxDuration": 30,
      "runtime": "python3.13"
    }
  },
  "env": {
    "PYTHON_VERSION": "3.13"
  },
  "installCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "framework": null,
  "outputDirectory": "."
}